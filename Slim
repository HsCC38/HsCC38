<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>史萊姆育成機</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{
  font-family:-apple-system,"PingFang HK","Microsoft JhengHei",sans-serif;
  background:#1a1a2e;color:#eee;min-height:100vh;
  display:flex;justify-content:center;align-items:center;
  overflow:hidden;user-select:none;
}
#app{
  width:100%;max-width:400px;height:100vh;max-height:800px;
  background:linear-gradient(180deg,#16213e,#0f3460);
  display:flex;flex-direction:column;position:relative;
  border-radius:16px;overflow:hidden;
}
/* 頂部狀態 */
#stats{padding:12px;display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:12px}
.stat{display:flex;align-items:center;gap:6px}
.stat .bar{flex:1;height:8px;background:#0a0a1a;border-radius:4px;overflow:hidden}
.stat .fill{height:100%;transition:width .3s;border-radius:4px}
.belly .fill{background:#ffb347}
.mood .fill{background:#ff6b9d}
.stamina .fill{background:#4ecdc4}
.clean .fill{background:#95e1d3}
/* 主畫面 */
#stage{
  flex:1;display:flex;flex-direction:column;
  justify-content:center;align-items:center;position:relative;
}
#slime{
  width:120px;height:100px;position:relative;
  transition:transform .2s;
  filter:drop-shadow(0 10px 20px rgba(0,0,0,.4));
}
#slime .body{
  width:100%;height:100%;border-radius:50% 50% 45% 45%/60% 60% 40% 40%;
  background:radial-gradient(circle at 35% 30%,#7ef7d0,#3ec9a7 60%,#2a9d8f);
  position:relative;animation:bounce 2s ease-in-out infinite;
}
#slime .eye{
  position:absolute;width:14px;height:18px;background:#1a1a2e;
  border-radius:50%;top:35%;
}
#slime .eye.l{left:28%}
#slime .eye.r{right:28%}
#slime .mouth{
  position:absolute;width:20px;height:10px;border-bottom:3px solid #1a1a2e;
  border-radius:0 0 50% 50%;bottom:22%;left:50%;transform:translateX(-50%);
}
#slime .blush{
  position:absolute;width:16px;height:8px;background:rgba(255,150,150,.6);
  border-radius:50%;top:52%;
}
#slime .blush.l{left:18%}
#slime .blush.r{right:18%}
@keyframes bounce{
  0%,100%{transform:scale(1,1) translateY(0)}
  50%{transform:scale(1.05,.95) translateY(-6px)}
}
#slime.happy{animation:jump .4s}
@keyframes jump{
  0%{transform:translateY(0)}
  50%{transform:translateY(-30px) scale(1.1,.9)}
  100%{transform:translateY(0)}
}
#slime.sad{filter:grayscale(.5) brightness(.8)}
#slime.eating .mouth{animation:chew .2s infinite}
@keyframes chew{
  0%,100%{height:10px}
  50%{height:4px}
}
#name{
  margin-top:16px;font-size:18px;font-weight:600;
}
#skill{
  margin-top:4px;font-size:12px;padding:3px 10px;border-radius:10px;
  background:rgba(255,255,255,.1);
}
#log{
  position:absolute;bottom:8px;left:0;right:0;text-align:center;
  font-size:12px;color:#aaa;height:18px;
}
/* 按鈕區 */
#actions{
  padding:12px;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;
}
button{
  padding:14px 0;border:none;border-radius:12px;font-size:13px;
  background:#0f3460;color:#eee;font-weight:600;
  transition:transform .1s,background .2s;cursor:pointer;
}
button:active{transform:scale(.95);background:#1a4a7a}
button:disabled{opacity:.4}
#shakeBtn{
  grid-column:span 4;padding:18px;font-size:16px;
  background:linear-gradient(135deg,#e94560,#c62a4a);
}
#shakeBtn:active{background:#c62a4a}
/* 戰鬥畫面 */
#battle{
  position:absolute;inset:0;background:rgba(10,10,26,.95);
  display:none;flex-direction:column;justify-content:center;
  align-items:center;padding:20px;z-index:10;
}
#battle.active{display:flex}
.enemy{
  width:80px;height:70px;border-radius:50% 50% 45% 45%/60% 60% 40% 40%;
  background:radial-gradient(circle at 35% 30%,#ff9a9e,#e94560);
  margin:20px 0;animation:bounce 1.5s infinite;
}
#battleLog{
  font-size:13px;text-align:center;line-height:1.8;margin:16px 0;
  min-height:80px;color:#ddd;
}
#battleResult{font-size:20px;font-weight:700;margin:10px 0}
/* 進化動畫 */
#evolve{
  position:absolute;inset:0;background:#000;display:none;
  justify-content:center;align-items:center;flex-direction:column;z-index:20;
}
#evolve.active{display:flex}
#evolve .glow{
  width:150px;height:150px;border-radius:50%;
  background:radial-gradient(circle,#fff,#7ef7d0,#3ec9a7);
  animation:pulse 1s infinite;
}
@keyframes pulse{
  0%,100%{transform:scale(1);opacity:.8}
  50%{transform:scale(1.3);opacity:1}
}
#evolveText{margin-top:20px;font-size:18px;color:#7ef7d0}
/* 提示 */
#toast{
  position:absolute;top:60px;left:50%;transform:translateX(-50%);
  background:rgba(0,0,0,.8);padding:8px 16px;border-radius:20px;
  font-size:13px;opacity:0;transition:opacity .3s;pointer-events:none;
  z-index:30;white-space:nowrap;
}
#toast.show{opacity:1}
</style>
</head>
<body>
<div id="app">
  <div id="stats">
    <div class="stat belly"><span>🍖</span><div class="bar"><div class="fill" id="bellyBar"></div></div></div>
    <div class="stat mood"><span>😊</span><div class="bar"><div class="fill" id="moodBar"></div></div></div>
    <div class="stat stamina"><span>⚡</span><div class="bar"><div class="fill" id="staminaBar"></div></div></div>
    <div class="stat clean"><span>💧</span><div class="bar"><div class="fill" id="cleanBar"></div></div></div>
  </div>

  <div id="stage">
    <div id="slime">
      <div class="body">
        <div class="eye l"></div>
        <div class="eye r"></div>
        <div class="mouth"></div>
        <div class="blush l"></div>
        <div class="blush r"></div>
      </div>
    </div>
    <div id="name">史萊姆</div>
    <div id="skill">技能：--</div>
    <div id="log"></div>
  </div>

  <div id="actions">
    <button onclick="feed()">🍖 餵食</button>
    <button onclick="clean()">💧 清潔</button>
    <button onclick="play()">🎾 玩耍</button>
    <button onclick="train()">💪 訓練</button>
    <button id="shakeBtn" onclick="shake()">📱 搖手機遇敵</button>
  </div>

  <div id="battle">
    <div style="font-size:14px;color:#aaa">野生史萊姆出現！</div>
    <div class="enemy"></div>
    <div id="battleLog"></div>
    <div id="battleResult"></div>
    <button onclick="closeBattle()" style="padding:12px 40px;margin-top:10px">返回</button>
  </div>

  <div id="evolve">
    <div class="glow"></div>
    <div id="evolveText">進化中…</div>
  </div>

  <div id="toast"></div>
</div>

<script>
// ============ 遊戲資料 ============
const SKILLS = [
  {name:'攻擊強化',rarity:'稀有',desc:'攻擊+15%'},
  {name:'防禦強化',rarity:'稀有',desc:'受傷-10%'},
  {name:'治療黏液',rarity:'稀有',desc:'每回合回血'},
  {name:'快速消化',rarity:'普通',desc:'餵食+20%'},
  {name:'自我清潔',rarity:'普通',desc:'清潔下降-30%'},
  {name:'貪吃鬼',rarity:'普通',desc:'掉落+1'},
  {name:'戰鬥掠奪',rarity:'史詩',desc:'勝利額外掉落'},
  {name:'元素親和',rarity:'史詩',desc:'進化點+50%'},
  {name:'突變因子',rarity:'傳說',desc:'隱藏進化機率'},
  {name:'王者資質',rarity:'神話',desc:'終極進化'},
];
const RARITY_COLOR = {普通:'#aaa',稀有:'#4ecdc4',史詩:'#b47aff',傳說:'#ffd700',神話:'#ff6b9d'};
const RARITY_CHANCE = {普通:60,稀有:25,史詩:12,傳說:2.5,神話:0.5};

const FOODS = [
  {name:'草葉',belly:10,mood:0,type:'普通'},
  {name:'樹果',belly:15,mood:5,type:'普通'},
  {name:'清水',belly:5,mood:0,type:'普通'},
  {name:'蘑菇',belly:20,mood:0,type:'普通'},
  {name:'鐵礦石',belly:5,mood:0,type:'金屬'},
  {name:'硫磺',belly:5,mood:0,type:'酸毒'},
  {name:'火藥草',belly:5,mood:0,type:'火'},
];
const TASTES = ['甜','酸','苦','辣','鮮'];

const STAGES = [
  {name:'黏液史萊姆',color:'#3ec9a7',minAge:0},
  {name:'進化史萊姆',color:'#4ecdc4',minAge:3},
  {name:'終極史萊姆',color:'#b47aff',minAge:7},
];

// ============ 遊戲狀態 ============
let state = load() || newGame();

function newGame(){
  const skill = rollSkill();
  const fav = TASTES[Math.floor(Math.random()*TASTES.length)];
  let dislike;
  do { dislike = TASTES[Math.floor(Math.random()*TASTES.length)]; } while(dislike===fav);
  return {
    belly:70, mood:70, stamina:70, clean:70,
    age:0, stage:0, exp:0,
    skill, fav, dislike,
    lastTick: Date.now(),
    foodInv: ['草葉','草葉','樹果','清水'],
    knownFav: false, knownDislike: false,
  };
}

function rollSkill(){
  const r = Math.random()*100;
  let acc = 0;
  let pool = [];
  for(const s of SKILLS){
    acc += RARITY_CHANCE[s.rarity];
    if(r <= acc) pool.push(s);
  }
  return pool[0] || SKILLS[0];
}

function save(){ localStorage.setItem('slime_save', JSON.stringify(state)); }
function load(){
  try{ return JSON.parse(localStorage.getItem('slime_save')); }catch(e){ return null; }
}

// ============ 核心循環 ============
function tick(){
  const now = Date.now();
  const dt = (now - state.lastTick) / 1000;
  if(dt < 1) return;
  state.lastTick = now;

  // 每秒衰減
  state.belly = Math.max(0, state.belly - 0.15*dt);
  state.mood = Math.max(0, state.mood - 0.08*dt);
  state.stamina = Math.max(0, state.stamina - 0.1*dt);
  state.clean = Math.max(0, state.clean - 0.12*dt);

  // 每 10 秒加年齡
  state.age += dt/10;

  // 進化檢查
  checkEvolve();

  render();
  save();
}

setInterval(tick, 1000);

// ============ 操作 ============
function feed(){
  if(state.foodInv.length === 0){ toast('冇食物！去戰鬥搵啦'); return; }
  const foodName = state.foodInv.shift();
  const food = FOODS.find(f=>f.name===foodName) || FOODS[0];

  let bellyGain = food.belly;
  let moodGain = food.mood;
  let reaction = '普通';

  // 適應性判定（簡化：用食物名對應味道）
  const foodTaste = getTaste(foodName);
  if(foodTaste === state.fav){ bellyGain *= 1.5; moodGain += 20; reaction='最愛'; state.knownFav=true; }
  else if(foodTaste === state.dislike){ bellyGain *= 0.3; moodGain -= 15; reaction='討厭'; state.knownDislike=true; }

  // 技能加成
  if(state.skill.name==='快速消化') bellyGain *= 1.2;

  state.belly = Math.min(100, state.belly + bellyGain);
  state.mood = Math.max(0, Math.min(100, state.mood + moodGain));
  state.clean = Math.max(0, state.clean - 3);

  animate('eating');
  if(reaction==='最愛') animate('happy');
  if(reaction==='討厭') animate('sad');

  toast(`食咗${foodName}（${reaction}）`);
  render(); save();
}

function getTaste(foodName){
  const map = {'草葉':'苦','樹果':'甜','清水':'鮮','蘑菇':'鮮','鐵礦石':'苦','硫磺':'辣','火藥草':'辣'};
  return map[foodName] || '普通';
}

function clean(){
  state.clean = Math.min(100, state.clean + 30);
  state.mood = Math.min(100, state.mood + 5);
  animate('happy');
  toast('清潔完成！');
  render(); save();
}

function play(){
  if(state.stamina < 10){ toast('體力不足'); return; }
  state.stamina -= 10;
  state.mood = Math.min(100, state.mood + 15);
  animate('happy');
  toast('玩得好開心！');
  render(); save();
}

function train(){
  if(state.stamina < 15){ toast('體力不足'); return; }
  state.stamina -= 15;
  state.exp += 5;
  state.belly = Math.max(0, state.belly - 5);
  animate('happy');
  toast('訓練+5 EXP');
  render(); save();
}

// ============ 搖手機遇敵 ============
let shaking = false;
let lastShake = 0;

function initShake(){
  if(typeof DeviceMotionEvent === 'undefined'){
    toast('此裝置唔支援搖動');
    return;
  }
  if(typeof DeviceMotionEvent.requestPermission === 'function'){
    DeviceMotionEvent.requestPermission().then(p=>{
      if(p==='granted') window.addEventListener('devicemotion', onMotion);
    }).catch(()=>{});
  } else {
    window.addEventListener('devicemotion', onMotion);
  }
}

function onMotion(e){
  const a = e.accelerationIncludingGravity;
  if(!a) return;
  const mag = Math.sqrt(a.x*a.x + a.y*a.y + a.z*a.z);
  const now = Date.now();
  if(mag > 25 && now - lastShake > 1000){
    lastShake = now;
    if(!shaking){ shaking = true; shake(); setTimeout(()=>shaking=false, 2000); }
  }
}

function shake(){
  // 桌面測試用：直接點擊都觸發
  const enemy = rollEnemy();
  startBattle(enemy);
}

function rollEnemy(){
  const r = Math.random();
  if(r < 0.6) return {name:'野生史萊姆',hp:30,atk:5,reward:'草葉'};
  if(r < 0.85) return {name:'進化史萊姆',hp:60,atk:10,reward:'鐵礦石'};
  if(r < 0.97) return {name:'稀有史萊姆',hp:100,atk:15,reward:'火藥草'};
  return {name:'BOSS史萊姆',hp:200,atk:25,reward:'黃金果'};
}

// ============ 戰鬥 ============
let battleState = null;

function startBattle(enemy){
  battleState = {enemy, playerHp:100, enemyHp:enemy.hp, turn:0, log:[]};
  document.getElementById('battle').classList.add('active');
  document.getElementById('battleResult').textContent = '';
  runBattle();
}

function runBattle(){
  const b = battleState;
  b.turn++;
  let log = `--- 回合 ${b.turn} ---\n`;

  // 玩家攻擊
  let playerAtk = 10 + Math.floor(state.exp/10);
  if(state.skill.name==='攻擊強化') playerAtk *= 1.15;
  b.enemyHp -= playerAtk;
  log += `你造成 ${Math.round(playerAtk)} 傷害\n`;

  // 治療技能
  if(state.skill.name==='治療黏液'){
    b.playerHp = Math.min(100, b.playerHp + 5);
    log += `治療黏液回復 5 HP\n`;
  }

  if(b.enemyHp <= 0){ endBattle(true); return; }

  // 敵人攻擊
  let enemyAtk = b.enemy.atk;
  if(state.skill.name==='防禦強化') enemyAtk *= 0.9;
  b.playerHp -= enemyAtk;
  log += `敵人造成 ${Math.round(enemyAtk)} 傷害\n`;

  if(b.playerHp <= 0){ endBattle(false); return; }

  document.getElementById('battleLog').textContent = log;
  setTimeout(runBattle, 600);
}

function endBattle(win){
  const b = battleState;
  const el = document.getElementById('battleResult');
  if(win){
    el.textContent = '🎉 勝利！';
    el.style.color = '#7ef7d0';
    let reward = b.enemy.reward;
    state.foodInv.push(reward);
    if(state.skill.name==='貪吃鬼' || state.skill.name==='戰鬥掠奪'){
      state.foodInv.push(reward);
    }
    state.exp += 10;
    toast(`獲得 ${reward}！`);
  } else {
    el.textContent = '💀 敗北…';
    el.style.color = '#e94560';
    state.mood = Math.max(0, state.mood - 20);
  }
  render(); save();
}

function closeBattle(){
  document.getElementById('battle').classList.remove('active');
  battleState = null;
}

// ============ 進化 ============
function checkEvolve(){
  const nextStage = state.stage + 1;
  if(nextStage >= STAGES.length) return;
  const req = STAGES[nextStage];
  if(state.age >= req.minAge && state.exp >= nextStage*20){
    evolve(nextStage);
  }
}

function evolve(stage){
  state.stage = stage;
  const el = document.getElementById('evolve');
  el.classList.add('active');
  document.getElementById('evolveText').textContent = `進化成 ${STAGES[stage].name}！`;
  document.getElementById('slime').querySelector('.body').style.background =
    `radial-gradient(circle at 35% 30%, #fff, ${STAGES[stage].color} 60%, #2a9d8f)`;
  setTimeout(()=>{ el.classList.remove('active'); }, 2500);
}

// ============ 渲染 ============
function render(){
  document.getElementById('bellyBar').style.width = state.belly + '%';
  document.getElementById('moodBar').style.width = state.mood + '%';
  document.getElementById('staminaBar').style.width = state.stamina + '%';
  document.getElementById('cleanBar').style.width = state.clean + '%';

  const s = STAGES[state.stage];
  document.getElementById('name').textContent = `${s.name}（${Math.floor(state.age)}日）`;
  document.getElementById('skill').textContent = `技能：${state.skill.name}`;
  document.getElementById('skill').style.color = RARITY_COLOR[state.skill.rarity];

  // 食物數量
  document.getElementById('log').textContent =
    `🍖食物：${state.foodInv.length} 個｜EXP：${state.exp}`;
}

function animate(cls){
  const el = document.getElementById('slime');
  el.classList.add(cls);
  setTimeout(()=>el.classList.remove(cls), 500);
}

function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(t._timer);
  t._timer = setTimeout(()=>t.classList.remove('show'), 1500);
}

// ============ 啟動 ============
initShake();
render();
toast('歡迎！點「搖手機遇敵」開始');
</script>
</body>
</html>
